# Gemini (get a free key at https://aistudio.google.com/apikey — no card needed)
GEMINI_API_KEY=AIzaSyDH5I4uMWiGEjZV4y-zYoxr_yww2jKkMV4
GEMINI_MODEL=gemini-3.6-flash

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_chunks

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Retrieval
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5
RRF_K=60

# Semantic cache
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Chunking
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_RATIO=0.2

# OpenTelemetry (optional — leave blank to log spans to console only)
OTEL_EXPORTER_OTLP_ENDPOINT=
