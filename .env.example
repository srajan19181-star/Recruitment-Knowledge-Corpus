# ==============================================================================
# Full-Stack Recruiter Copilot & Compliance Platform
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local Docker Compose runs.
# NEVER commit your actual .env file or production secrets to Git.

# ------------------------------------------------------------------------------
# 1. Database & Persistence (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruiter_copilot
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/recruiter_copilot

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 2. Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_chunks
QDRANT_CACHE_COLLECTION=semantic_cache

# ------------------------------------------------------------------------------
# 3. AI Service & LLM Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Provider: "mock" (offline testing / CI) or "gemini" (live Google Gemini API)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared internal service secret between Node gateway and FastAPI AI service
INTERNAL_API_KEY=dev-internal-secret-key

# Embedding Model (Sentence Transformers runs locally without external API costs)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Hybrid Retrieval Settings (Reciprocal Rank Fusion)
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5
RRF_K=60

# Semantic Cache Configuration
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600

# Rate Limiting (Atomic Redis Lua sliding window per user)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Ingestion & Chunking
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_RATIO=0.2

# OpenTelemetry Tracing (optional - leave blank to output to console/logs)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------------------
# 4. API Gateway Configuration (Node.js / Express / TypeScript)
# ------------------------------------------------------------------------------
GATEWAY_PORT=5000
NODE_ENV=development
JWT_SECRET=super-secure-jwt-secret-min-32-characters-long
CORS_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://ai-service:8000

# ------------------------------------------------------------------------------
# 5. Web Frontend Configuration (Next.js 14 App Router)
# ------------------------------------------------------------------------------
PORT=3000
GATEWAY_INTERNAL_URL=http://gateway:5000
